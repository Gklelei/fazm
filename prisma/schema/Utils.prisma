model academy {
  id                 String   @id @default(cuid())
  paymentMathod      String
  paymentMethodType  String
  /// Paybill account number parents type: ATHLETE_ID or INVOICE_NUMBER; empty: none asked
  paymentReference   String?  @map("payment_reference")
  /// Optional second way to pay
  bankName           String?  @map("bank_name")
  bankAccountName    String?  @map("bank_account_name")
  bankAccountNumber  String?  @map("bank_account_number")
  bankBranch         String?  @map("bank_branch")
  academyName        String   @map("academy_name")
  tagline            String?  @map("tagline")
  description        String?  @map("description")
  contactEmail       String?  @map("contact_email")
  contactPhone       String?  @map("contact_phone")
  address            String?  @map("address")
  logoUrl            String?  @map("logo_url")
  /// Printed on invoices and receipts
  signatureUrl       String?  @map("signature_url")
  stampUrl           String?  @map("stamp_url")
  heroImageUrl       String?  @map("hero_image_url")
  receiptFooterNotes String?  @map("receipt_notes")
  primaryColor       String?  @map("primary_color")
  /// The app's look: sidebar and its highlight (fazam, pitch, charcoal, light)
  theme              String   @default("fazam")
  /// Who sees programmes (Boys, Girls, Elite): off, preview (the super admin only), on (everyone)
  programmesMode     String   @default("preview") @map("programmes_mode")

  // Documents (invoices, receipts)
  invoicePrefix  String  @default("INV") @map("invoice_prefix")
  receiptPrefix  String  @default("FEES") @map("receipt_prefix")
  invoiceDueDays Int     @default(7) @map("invoice_due_days")
  documentTerms  String? @map("document_terms")
  kraPin         String? @map("kra_pin")

  // Fees
  defaultPlanId       String?  @map("default_plan_id")
  /// Empty: no late fees
  lateFeeAmount       Decimal? @map("late_fee_amount") @db.Decimal(10, 2)
  lateFeeGraceDays    Int      @default(7) @map("late_fee_grace_days")
  /// Off every fees invoice for each child after a family's first: PERCENTAGE or FIXED_AMOUNT; empty: none
  siblingDiscountType  String?  @map("sibling_discount_type")
  siblingDiscountValue Decimal? @map("sibling_discount_value") @db.Decimal(10, 2)
  /// Shop: a size counts as low at or below this
  lowStockLevel Int @default(5) @map("low_stock_level")

  // Attendance and sessions
  inactiveWeeks      Int  @default(13) @map("inactive_weeks")
  /// Days after a session its attendance can be changed; empty: always
  attendanceEditDays Int? @map("attendance_edit_days")
  sessionMinutes     Int  @default(90) @map("session_minutes")

  // Registration
  requiredDocuments String[] @default([]) @map("required_documents")

  // Email
  senderName     String?  @map("sender_name")
  senderEmail    String?  @map("sender_email")
  replyTo        String?  @map("reply_to")
  smtpHost       String?  @map("smtp_host")
  smtpPort       Int?     @map("smtp_port")
  smtpUser       String?  @map("smtp_user")
  /// Encrypted (AES-256-GCM); never sent to the browser
  smtpPassword   String?  @map("smtp_password")
  smtpSecure     Boolean  @default(true) @map("smtp_secure")
  financeReportTo String[] @default([]) @map("finance_report_to")
  emailInvoices  Boolean  @default(false) @map("email_invoices")
  emailReceipts  Boolean  @default(false) @map("email_receipts")
  emailOverdue   Boolean  @default(false) @map("email_overdue")

  // Security and data
  /// Sign out after this many idle minutes; empty: never
  sessionTimeoutMinutes Int? @map("session_timeout_minutes")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
}
