model Athlete {
  /// Shop sales to them
  sales Sale[]
  id                   String                      @id @default(uuid())
  athleteId            String                      @unique @map("athlete_id")
  /// The ID before the one-off move to per-programme IDs (ATH-FFA-501); old links, papers and searches still find them
  formerAthleteId      String?                     @unique @map("former_athlete_id")
  firstName            String                      @map("first_name")
  lastName             String                      @map("last_name")
  email                String?                     @unique
  age                  Int?
  phoneNumber          String?                     @map("phone_number")
  dateOfBirth          String                      @map("date_of_birth")
  profilePIcture       String?                     @map("profile_picture")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  middleName           String?                     @map("middle_name")
  nextBillingDate      DateTime?
  /// Set when staff stop their billing (plan ended, none started); cleared when a plan is given.
  /// The invoice form flags them "No plan".
  billingStoppedAt     DateTime?                   @map("billing_stopped_at")
  status               ATHLETE_ACCOUNT_STATUS      @default(PENDING)
  batchesId            String                      @map("batches_id")
  height               String
  weight               String
  foot                 String
  hand                 String
  positions            String[]
  birthCertificate     String?                     @map("bith_certificate")
  nationalIdFront      String?                     @map("national_id_front")
  nationalIdBack       String?                     @map("national_id_back")
  passportCover        String?                     @map("passport_cover")
  passportBioData      String?                     @map("passport_bio_data")
  batches              Batches?                    @relation(fields: [batchesId], references: [id])
  address              AthleteAddress?
  emergencyContacts    AthleteEmergencyContact[]
  guardians            AthleteGuardian[]
  medical              AthleteMedicalAndEmergency?
  finances             Finance[]
  trainings            training[]                  @relation("TrainingToAthletes")
  attendances          attendance[]
  invoices             Invoice[]
  assessments          Assessment[]
  isArchived           Boolean                     @default(false) @map("is_archived")
  ArchiveDate          DateTime?
  athleteSubscriptions AthleteSubscription[]
  couponRedemptions    CouponRedemption[]
  auditLogs            AuditLog[]
  consents             AthleteConsent[]
  /// Siblings confirmed by staff share a family (statement, split payments, sibling discount)
  familyId             String?                     @map("family_id")
  family               Family?                     @relation(fields: [familyId], references: [id], onDelete: SetNull)

  transfers            AthleteTransfer[]

  @@index([familyId])
  @@map("athlete")
}

/// An athlete moved to a batch in another programme. Their ID and records stay; money billed
/// before stays with the old programme (stamped), and new bills follow the new batch.
model AthleteTransfer {
  id              String    @id @default(cuid())
  athleteId       String    @map("athlete_id")
  athlete         Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  fromBatchId     String    @map("from_batch_id")
  fromBatch       Batches   @relation("TransferFromBatch", fields: [fromBatchId], references: [id], onDelete: Restrict)
  toBatchId       String    @map("to_batch_id")
  toBatch         Batches   @relation("TransferToBatch", fields: [toBatchId], references: [id], onDelete: Restrict)
  fromProgrammeId String    @map("from_programme_id")
  fromProgramme   Programme @relation("TransferFromProgramme", fields: [fromProgrammeId], references: [id], onDelete: Restrict)
  toProgrammeId   String    @map("to_programme_id")
  toProgramme     Programme @relation("TransferToProgramme", fields: [toProgrammeId], references: [id], onDelete: Restrict)
  /// When the move took effect
  date            DateTime  @default(now())
  reason          String?
  /// Who made it (the activity log has the rest)
  byUserId        String?   @map("by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([athleteId, date])
  @@index([fromProgrammeId, date])
  @@index([toProgrammeId, date])
  @@map("athlete_transfers")
}

/// Brothers and sisters billed together. Staff link them; the guardian's phone only suggests.
model Family {
  id        String    @id @default(cuid())
  athletes  Athlete[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("families")
}

model AthleteSequence {
  id      Int @id @default(1)
  current Int

  @@map("athlete_sequence")
}

model AthleteGuardian {
  id           String  @id @default(uuid())
  fullNames    String  @map("full_names")
  relationship String
  email        String
  phoneNumber  String  @map("phone_number")
  athleteId    String  @map("athlete_id")
  athlete      Athlete @relation(fields: [athleteId], references: [athleteId], onDelete: Cascade)

  @@index([athleteId])
  @@map("athlete_guardian")
}

model AthleteMedicalAndEmergency {
  id                String   @id @default(uuid())
  bloogGroup        String   @map("blood_group")
  allergies         String[] @default([])
  medicalConditions String[] @default([])
  athleteId         String   @unique @map("athlete_id")
  athlete           Athlete  @relation(fields: [athleteId], references: [athleteId], onDelete: Cascade)

  @@map("athlete_medical_and_emrgency")
}

model AthleteAddress {
  id           String  @id @default(uuid())
  country      String
  town         String
  addressLine1 String  @map("address_line_1")
  addressLine2 String  @map("address_line_2")
  athleteId    String  @unique @map("athlete_id")
  estate       String
  athlete      Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("athlete_address")
}

model AthleteEmergencyContact {
  id           String  @id @default(uuid())
  name         String
  phoneNumber  String  @map("phone_number")
  relationship String
  athleteId    String  @map("athlete_id")
  athlete      Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("athlete_emergency_contact")
}

enum ATHLETE_ACCOUNT_STATUS {
  ACTIVE
  PENDING
  DEACTIVATED
  DEFAULT
}

/// Consent for an athlete's data, emergency treatment and photos. Every change
/// adds a row; the newest row is the current consent (history is kept).
model AthleteConsent {
  id                  String         @id @default(cuid())
  athleteId           String
  athlete             Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /// Which consent text was agreed to, e.g. "1"
  version             String
  language            String         @default("en")
  dataUse             Boolean
  emergencyTreatment  Boolean
  photos              Boolean
  /// The parent or guardian, or the athlete when 18 or over
  givenByName         String
  givenByRelationship String
  method              CONSENT_METHOD
  /// The signed form, when method is SIGNED_FORM
  formUrl             String?
  givenAt             DateTime
  recordedById        String?
  recordedBy          User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  note                String?
  createdAt           DateTime       @default(now())

  @@index([athleteId, createdAt])
  @@map("athlete_consent")
}

enum CONSENT_METHOD {
  IN_PERSON
  SIGNED_FORM
}
