model training {
  id                  String          @id @default(cuid())
  batchesId           String
  date                DateTime
  description         String
  name                String
  note                String?
  status              TRAINING_STATUS @default(SCHEDULED)
  duration            Int
  isArchived          Boolean         @default(false)
  trainingLocationsId String
  staffId             String

  // KEEP THIS EXACTLY (no relation name change)
  batch Batches @relation(fields: [batchesId], references: [id])

  coach    staff             @relation(fields: [staffId], references: [staffId])
  location TrainingLocations @relation(fields: [trainingLocationsId], references: [id])

  // DO NOT TOUCH (keeps drills relations stable)
  drills     drills[] @relation("TrainingToDrills")
  drillOrder String[] @default([])

  athletes    Athlete[]    @relation("TrainingToAthletes")
  attendances attendance[]
  assessments Assessment[]
  auditLogs   AuditLog[]
}

/// Boys, Girls, Elite: each runs its own batches, money and training, looked at apart or together
model Programme {
  id         String   @id @default(cuid())
  name       String
  /// Order in the switcher and reports
  sortOrder  Int      @default(0) @map("sort_order")
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  batches  Batches[]
  /// Expenses charged to this programme; the rest are shared
  expenses Expenses[]
  /// Fee plans only for this programme; the rest fit any
  plans    SubscriptionPlan[]

  @@map("programmes")
}

model Batches {
  id          String  @id @default(cuid())
  name        String
  description String?

  /// Athletes, sessions and money of the batch count towards this programme
  programmeId String    @map("programme_id")
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  // ✅ NEW: batch date range (optional so old rows don’t break)
  startDate DateTime?
  endDate   DateTime?

  athletes Athlete[]

  // KEEP SAME FIELD NAME to avoid breaking code that uses batches.sessions
  sessions training[]

  // ✅ NEW: schedule rules (optional feature)
  schedules BatchSchedule[]
  coaches   staff[]         @relation("CoachBatches")

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  auditLogs AuditLog[]

  @@index([programmeId])
  @@map("batches")
}

model BatchSchedule {
  id      String  @id @default(cuid())
  batchId String
  batch   Batches @relation(fields: [batchId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  time      String // "HH:mm", academy time (Africa/Nairobi)
  endTime   String? // "HH:mm"; null on rows from before timetables

  trainingLocationsId String?
  location            TrainingLocations? @relation(fields: [trainingLocationsId], references: [id], onDelete: SetNull)
  staffId             String?
  coach               staff?             @relation(fields: [staffId], references: [staffId], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([batchId])
  @@map("batch_schedules")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model drills {
  id          String     @id @default(cuid())
  value       String
  name        String
  description String?
  voided      Int        @default(0)
  trainings   training[] @relation("TrainingToDrills")
  auditLogs   AuditLog[]

  @@map("drills")
}

model attendance {
  id         String           @id @default(cuid())
  trainingId String
  athleteId  String
  coachId    String
  status     AttendanceStatus @default(ABSENT)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  training training                     @relation(fields: [trainingId], references: [id])
  athlete  Athlete                      @relation(fields: [athleteId], references: [athleteId])
  coach    staff                        @relation(fields: [coachId], references: [staffId])
  reason   TRAINING_ATTENDANCE_REASONS? @relation(fields: [reasonId], references: [id])
  reasonId String?

  @@unique([trainingId, athleteId])
  @@map("attendance")
}

model TrainingLocations {
  id        String          @id @default(cuid())
  name      String
  value     String
  voided    Int             @default(0)
  trainings training[]
  schedules BatchSchedule[]

  @@map("training_locations")
}

model TRAINING_ATTENDANCE_REASONS {
  id          String           @id @default(cuid())
  status      AttendanceStatus
  label       String?
  isArchived  Boolean          @default(false)
  attendances attendance[]

  @@map("training_attendance_reasons")
}

enum TRAINING_STATUS {
  COMPLETED
  CANCELLED
  SCHEDULED
  IN_PROGRESS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
