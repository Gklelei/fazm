// ===== ENUMS =====
enum PAYMENT_TYPE {
  CASH
  BANK_TRANSFER
  MPESA_SEND_MONEY
  MPESA_PAYBILL
}

enum INVOICE_STATUS {
  PENDING
  PARTIAL
  PAID
  CANCELED
  OVERDUE
}

enum INVOICE_TYPE {
  SUBSCRIPTION
  MANUAL
  LATE_FEE
  ITEM_PURCHASE
}

enum SUBSCRIPTION_STATUS {
  ACTIVE
  PAUSED
  CANCELED
  EXPIRED
  INACTIVE
}

enum SUB_FREQUENCY {
  YEARLY
  MONTHLY
  DAILY
  WEEKLY
  ONCE
}

// ===== MODELS =====

model SubscriptionPlan {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  amount      Decimal       @db.Decimal(10, 2)
  interval    SUB_FREQUENCY
  description String?
  isActive    Boolean       @default(true)
  isArchived  Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeSubscriptions AthleteSubscription[]
  invoices            Invoice[]

  /// Coupons that only work on this plan
  coupons             Coupon[]            @relation("CouponPlans")

  /// Only offered to this programme's athletes; empty: any programme
  programmeId String?    @map("programme_id")
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  @@map("subscription_plans")
}

// Athlete's active subscription instance
model AthleteSubscription {
  id String @id @default(uuid())

  // Links
  athleteId          String
  athlete            Athlete          @relation(fields: [athleteId], references: [athleteId])
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  // Subscription instance details
  startDate DateTime            @default(now())
  endDate   DateTime? // Null if ongoing
  status    SUBSCRIPTION_STATUS @default(ACTIVE)

  // Auto-renew settings
  autoRenew         Boolean @default(true)
  cancelAtPeriodEnd Boolean @default(false)

  // Current billing period
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // Trial period (if applicable)
  trialStart DateTime?
  trialEnd   DateTime?

  // Payment method reference (if you have payment method table)
  paymentMethodId String?

  // Invoices generated for this subscription
  invoices Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String? // Track who updated this subscription
  finances  Finance[]

  @@index([athleteId, status])
  @@index([currentPeriodEnd])
  @@index([endDate])
  @@map("athlete_subscriptions")
}

// Invoice (connects athlete to subscription plan/instance)
model Invoice {
  /// The shop sale charged to the athlete's account
  sale Sale?
  id            String @id @default(uuid())
  invoiceNumber String @unique

  // Athlete
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [athleteId])

  /// Programme and batch the athlete was in when billed, so reports keep it there after a transfer.
  /// Set by the database on insert (trigger stamp_invoice): the athlete's batch, or for a late fee the overdue invoice's.
  programmeId String?    @map("programme_id")
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  batchId     String?    @map("batch_id")
  batch       Batches?   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  // Subscription plan (for subscription invoices)
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  // Active subscription instance (if applicable)
  athleteSubscriptionId String?
  athleteSubscription   AthleteSubscription? @relation(fields: [athleteSubscriptionId], references: [id])

  // Invoice details
  type        INVOICE_TYPE @default(SUBSCRIPTION)
  description String?

  // Pricing
  unitAmount Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(1)
  amountDue  Decimal  @db.Decimal(10, 2)
  discount   Decimal? @db.Decimal(10, 2)

  // Payment status
  amountPaid Decimal        @default(0) @db.Decimal(10, 2)
  status     INVOICE_STATUS @default(PENDING)
  dueDate    DateTime

  // For recurring invoices
  isRecurring     Boolean   @default(false)
  billingCycle    String? // e.g., "2024-12" for December 2024
  periodStart     DateTime? // Billing period start
  periodEnd       DateTime? // Billing period end
  nextBillingDate DateTime?

  // Metadata
  issuedBy String? // Who created the invoice
  notes    String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  finances  Finance[]
  /// What the invoice is for; amountDue is always the sum of the lines
  lines     InvoiceLine[]
  /// Each discount on the invoice (coupons, the sibling discount); `discount` is their sum
  discounts   InvoiceDiscount[]
  /// Coupons given for this invoice alone
  redemptions CouponRedemption[]
  auditLogs AuditLog[]

  @@index([athleteId])
  @@index([subscriptionPlanId])
  @@index([athleteSubscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([programmeId])
  @@index([batchId])
  @@map("invoices")

  /// For a late fee: the overdue invoice it was charged on
  lateFeeForId String?   @unique @map("late_fee_for_id")
  lateFeeFor   Invoice?  @relation("LateFee", fields: [lateFeeForId], references: [id], onDelete: SetNull)
  lateFee      Invoice?  @relation("LateFee")
  /// Last overdue reminder emailed to the guardian
  remindedAt   DateTime? @map("reminded_at")
}

// Payment records
model Finance {
  id    String  @id @default(uuid())
  notes String?

  // Links
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [athleteId], onDelete: Restrict)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Programme and batch the money counts towards: the invoice's, or the athlete's batch when paid without one.
  /// Set by the database on insert and when the invoice changes (trigger stamp_finance).
  programmeId String?    @map("programme_id")
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  batchId     String?    @map("batch_id")
  batch       Batches?   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  // Payment details
  amountPaid    Float        @map("amount_paid")
  collectedBy   String       @map("collected_by")
  paymentDate   DateTime     @default(now()) @map("payment_date")
  paymentType   PAYMENT_TYPE @default(CASH) @map("payment_type")
  receiptNumber String       @unique @map("receipt_number")

  // Reference to subscription (optional)
  athleteSubscriptionId String?
  athleteSubscription   AthleteSubscription? @relation(fields: [athleteSubscriptionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  isArchived Boolean @default(false)

  @@index([athleteId])
  @@index([invoiceId])
  @@index([athleteSubscriptionId])
  @@index([paymentDate])
  @@index([programmeId])
  @@index([batchId])
  @@map("finance")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// How long a coupon given to an athlete keeps discounting their fees invoices
enum CouponDuration {
  /// One invoice
  ONCE
  /// The next `durationCount` fees invoices
  INVOICES
  /// Every fees invoice until it's removed
  ALWAYS
}

enum RedemptionStatus {
  ACTIVE
  /// It has discounted as many invoices as it lasts
  ENDED
  /// Taken off (it no longer counts as a use)
  REMOVED
}

enum InvoiceDiscountKind {
  COUPON
  SIBLING
  /// A discount from before discounts had their own lines
  OTHER
}

model Coupon {
  id   String @id @default(cuid())
  name String @unique

  discountType DiscountType @default(PERCENTAGE) @map("discount_type")
  value        Decimal      @db.Decimal(10, 2)

  duration      CouponDuration @default(ONCE)
  /// For INVOICES: how many fees invoices
  durationCount Int?           @map("duration_count")

  startDate  DateTime  @default(now()) @map("start_date")
  expiryDate DateTime? @map("expiry_date")

  /// The most times it can be given (each redemption is one use; removed ones don't count)
  usageLimit Int? @map("usage_limit")
  /// An athlete can get it only once
  oncePerAthlete Boolean @default(false) @map("once_per_athlete")
  /// Only these fee plans' charges; none = any charge
  plans          SubscriptionPlan[] @relation("CouponPlans")
  status     Int  @default(1) /* 1 for active and 0 for inactive */
  voided     Int  @default(0) /* 1 - voided 0 - not voided */

  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at")
  redemptions   CouponRedemption[]

  @@map("coupons")
}

/// A coupon given to an athlete (it discounts their next fees invoices) or to one invoice. Uses
/// are counted from these rows, never kept in a counter.
model CouponRedemption {
  id           String            @id @default(cuid())
  couponId     String            @map("coupon_id")
  coupon       Coupon            @relation(fields: [couponId], references: [id])
  athleteId    String            @map("athlete_id")
  athlete      Athlete           @relation(fields: [athleteId], references: [athleteId])
  /// Given for this invoice alone (null: given to the athlete)
  invoiceId    String?           @map("invoice_id")
  invoice      Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Fees invoices it still discounts (null: no end)
  invoicesLeft Int?              @map("invoices_left")
  status       RedemptionStatus  @default(ACTIVE)
  givenById    String?           @map("given_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  endedAt      DateTime?         @map("ended_at")
  removedAt    DateTime?         @map("removed_at")
  removedById  String?           @map("removed_by_id")
  discounts    InvoiceDiscount[]

  @@index([athleteId, status])
  @@index([couponId, status])
  @@map("coupon_redemptions")
}

/// One discount on an invoice, with the terms it was worked out from, so it can be worked out
/// again the same way when the invoice's lines change (a coupon edited later never changes it).
model InvoiceDiscount {
  id           String              @id @default(cuid())
  invoiceId    String              @map("invoice_id")
  invoice      Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind         InvoiceDiscountKind
  redemptionId String?             @map("redemption_id")
  redemption   CouponRedemption?   @relation(fields: [redemptionId], references: [id])
  /// As shown on the invoice and statement: "SUMMER10 (10%)", "Sibling discount"
  label        String
  amount       Decimal             @db.Decimal(10, 2)
  discountType DiscountType        @map("discount_type")
  value        Decimal             @db.Decimal(10, 2)
  /// Only these fee plans' charges; empty: the whole invoice
  planIds      String[]            @map("plan_ids")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([redemptionId])
  @@map("invoice_discounts")
}

model Expenses {
  id            String            @id @default(cuid())
  name          String
  expenseNumber String            @unique @default(cuid()) @map("expense_number")
  description   String?           @map("Description")
  amount        Float
  date          DateTime
  status        String? /* EXPENSE_STATUS    @default(PENDING) */
  categoryId    String            @map("category_id")
  isArchived    Boolean           @default(false)
  category      ExpenseCategories @relation(fields: [categoryId], references: [id])
  /// Empty: shared by all programmes (pitch hire, transport)
  programmeId   String?           @map("programme_id")
  programme     Programme?        @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("expenses")
}

model ExpenseCategories {
  id          String                  @id @default(cuid())
  name        String
  status      EXPENSECATGORIES_STATUS
  description String?
  isArchived  Boolean                 @default(false)
  expenses    Expenses[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("expense_categories")
}

enum EXPENSECATGORIES_STATUS {
  ACTIVE
  INACTIVE
}

/// One charge on an invoice (e.g. "Monthly training", "Training kit").
model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(10, 2)
  /// quantity x unitAmount
  amount      Decimal @db.Decimal(10, 2)
  /// Set when the line came from a fee plan
  subscriptionPlanId String?

  @@index([invoiceId, position])
  @@map("invoice_lines")
}
