# PostgreSQL connection string used by Prisma (prisma/schema/schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/fazm"

# better-auth
# Secret used to sign sessions/tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of this app, used as the trusted origin in production (src/lib/auth.ts)
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary (image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mailtrap (transactional email)
MAILTRAP_API_KEY=""
# Set to "true" to send through a Mailtrap sandbox inbox (requires MAILTRAP_INBOX_ID)
MAILTRAP_IS_SANDBOX="false"
MAILTRAP_INBOX_ID=""
# Sender address for emails; must be a domain verified in Mailtrap
MAIL_FROM=""

# Shared secret for /api/cron-jobs/<job> (called by the server crontab,
# scripts/cron/). At least 16 characters: openssl rand -hex 32
CRON_SECRET=""

# Who receives the Monday finance summary (comma-separated)
FINANCE_REPORT_EMAILS=""

# Local filesystem root for uploaded files (src/... upload routes)
UPLOAD_ROOT="./uploads"

# Super admin created by `yarn seed admin` (prisma/seed/admin.ts).
# Self sign-up is disabled, so this is how the first account is made.
# The email defaults to the academy owner's; only the password is required.
SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_EMAIL=""   # optional override
SEED_ADMIN_NAME="System Admin"
